; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Auracole"
run/main_scene="uid://dnf8g7fix7urx"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"2-0": "res://story/2-0.dch",
"QingYun": "res://story/QingYun.dch",
"boy": "res://resources/boy.dch",
"child": "res://story/child.dch",
"commander": "res://resources/commander.dch",
"girl": "res://story/girl.dch"
}
directories/dtl_directory={
"1-2": "res://story/1-2.dtl",
"2-0": "res://story/2-0.dtl",
"begin": "res://story/begin.dtl",
"beginner": "res://story/beginner_1.dtl",
"beginner_2": "res://story/beginner_2.dtl",
"building": "res://story/building.dtl",
"jisuan": "res://story/jisuan.dtl"
}
layout/style_directory={
"": "res://story/beginner_style.tres",
"beginner_style": "res://story/beginner_style.tres",
"style": "res://story/style.tres"
}
layout/style_list=["res://story/beginner_style.tres", "res://story/style.tres"]
layout/default_style="res://story/beginner_style.tres"
glossary/default_case_sensitive=true
variables={}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/size/viewport_width=1900
window/size/viewport_height=1200
window/size/mode=4

[dotnet]

project/assembly_name="Auracole"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/godot_mcp/plugin.cfg")

